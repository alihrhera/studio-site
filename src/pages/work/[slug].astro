---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Screen from '../../components/Screen.astro';
import Audit from '../../components/Audit.astro';
import Footer from '../../components/Footer.astro';
import { layers, samples, shotsFor, shownName, sorted } from '../../data/layers';

export async function getStaticPaths() {
  const all = sorted(await getCollection('projects'));
  return all.map((p, i) => ({ params: { slug: p.id }, props: { p, next: all[(i + 1) % all.length] } }));
}
const { p, next } = Astro.props as { p: CollectionEntry<'projects'>; next: CollectionEntry<'projects'> };
const name = shownName(p);
const shots = shotsFor(p);
const label = (id: string) => layers.find((l) => l.id === id)!.label;
---
<Base title={`${name}: case study`} description={p.data.summary}>
  <section class="case-hero" style={`--f:${p.data.color}`} data-field={p.data.color} data-ink="#16181d">
    <a class="link back" href="/work/">All work</a>
    <h1 class="display reveal">{name}</h1>
    <p class="lead reveal">{p.data.summary}</p>
  </section>

  <section class="case-meta" data-field="#f2eee6" data-ink="#16181d">
    <dl class="facts facts--wide reveal">
      <div><dt>Our part</dt><dd>{p.data.role}</dd></div>
      <div><dt>Layers</dt><dd>{p.data.layers.map(label).join(', ')}</dd></div>
      {p.data.period && <div><dt>Period</dt><dd>{p.data.period}</dd></div>}
    </dl>
  </section>

  <section class="case-block" data-field="#dfd9cb" data-ink="#16181d">
    <h2 class="head reveal">The problem</h2>
    <p class="statement reveal">{p.data.problem}</p>
  </section>

  <section class="case-solution" style={`--f:${p.data.color}`} data-field={p.data.color} data-ink="#16181d">
    <div>
      <h2 class="head reveal">What we built</h2>
      <p class="statement reveal">{p.data.solution}</p>
    </div>
    {shots.length > 0 ? (
      <div class="case-shots">
        {shots.map((s) => (
          <figure class={`shot shot--${s.kind} reveal`}>
            <img src={s.src} alt={s.alt} loading="lazy" decoding="async" width={s.width} height={s.height} />
          </figure>
        ))}
      </div>
    ) : (
      <div class="case-screens">
        <Screen {...p.data.fragment} label={`Sample screen from ${name}`} />
        {p.data.layers.map((id) => {
          const l = layers.find((x) => x.id === id)!;
          return <Screen kind={l.kind} title={l.label} rows={samples[id]} label={`Sample ${l.label} screen from ${name}`} />;
        })}
      </div>
    )}
  </section>

  {p.data.result && (
    <section class="case-block" data-field="#f2eee6" data-ink="#16181d">
      <h2 class="head reveal">The result</h2>
      <p class="statement reveal">{p.data.result}</p>
    </section>
  )}

  <a class="case-next" href={`/work/${next.id}/`} style={`--f:${next.data.color}`} data-field={next.data.color} data-ink="#16181d">
    <span class="head reveal">Next: {shownName(next)}</span>
    <Screen {...next.data.fragment} label={`Sample screen from ${shownName(next)}`} />
  </a>

  <Audit />
  <Footer />
</Base>
