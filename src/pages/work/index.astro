---
import { getCollection } from 'astro:content';
import { workHeading } from '../../data/layers';
import Base from '../../layouts/Base.astro';
import WorkChapters from '../../components/WorkChapters.astro';
import Audit from '../../components/Audit.astro';
import Footer from '../../components/Footer.astro';
const projects = await getCollection('projects');
---
<Base title={`Work: ${workHeading(projects.length).toLowerCase()}`} description="Case studies of apps, APIs and dashboards we built, and what our part was in each.">
  <section class="page-head" data-field="#f2eee6" data-ink="#16181d">
    <h1 class="display reveal">{workHeading(projects.length)}</h1>
    <p class="lead reveal">Some were ours, some we built inside a client's team. Each page says which part we did.</p>
  </section>
  <WorkChapters />
  <section class="page-head" data-field="#f2eee6" data-ink="#16181d">
    <h2 class="head reveal">Freelance work</h2>
    <p class="lead reveal">We also work on products other teams built. On Zajil, Hadreen and Taxigo that meant fixes and improvements, getting the app running, better performance and a smoother user experience.</p>
  </section>
  <Audit />
  <Footer />
</Base>
