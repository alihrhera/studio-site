---
import { getCollection } from 'astro:content';
import { layerLabel, shotsFor, shownName, sorted, text, url } from '../data/layers';
import { ui, type Locale } from '../i18n';
import Screen from './Screen.astro';

const { locale } = Astro.props as { locale: Locale };
const t = ui[locale];
const projects = sorted(await getCollection('projects'));
---
{projects.map((p) => {
  const shot = shotsFor(p, locale)[0];
  return (
  <article class="chapter" id={p.id} style={`--f:${p.data.color}`} data-field={p.data.color} data-ink="#16181d">
    <h2 class="head reveal">{shownName(p, locale)}</h2>
    <div class="chapter-body">
      <div class="chapter-text">
        <p class="lead reveal">{text(p, locale).summary}</p>
        <dl class="facts reveal">
          <div><dt>{t.work.ourPart}</dt><dd>{text(p, locale).role}</dd></div>
          <div><dt>{t.work.layers}</dt><dd>{p.data.layers.map((id) => layerLabel(id, locale)).join(t.sep)}</dd></div>
        </dl>
        <a class="link reveal" href={url(`work/${p.id}/`, locale)}>{t.work.read}</a>
      </div>
      {shot ? (
        <figure class={`shot shot--${shot.kind} shot--chapter reveal`}>
          <img src={url(shot.src)} alt={shot.alt} loading="lazy" decoding="async" width={shot.width} height={shot.height} />
        </figure>
      ) : (
        <Screen {...p.data.fragment} label={t.case.sampleFrom(shownName(p, locale))} />
      )}
    </div>
  </article>
  );
})}
