---
import { getCollection } from 'astro:content';
import { layers, shotsFor, shownName, sorted, url } from '../data/layers';
import Screen from './Screen.astro';

const projects = sorted(await getCollection('projects'));
const layerLabel = (id: string) => layers.find((l) => l.id === id)!.label;
---
{projects.map((p) => (
  <article class="chapter" id={p.id} style={`--f:${p.data.color}`} data-field={p.data.color} data-ink="#16181d">
    <h2 class="head reveal">{shownName(p)}</h2>
    <div class="chapter-body">
      <div class="chapter-text">
        <p class="lead reveal">{p.data.summary}</p>
        <dl class="facts reveal">
          <div><dt>Our part</dt><dd>{p.data.role}</dd></div>
          <div><dt>Layers</dt><dd>{p.data.layers.map(layerLabel).join(', ')}</dd></div>
        </dl>
        <a class="link reveal" href={url(`work/${p.id}/`)}>Read the case study</a>
      </div>
      {shotsFor(p)[0] ? (
        <figure class={`shot shot--${shotsFor(p)[0].kind} shot--chapter reveal`}>
          <img src={url(shotsFor(p)[0].src)} alt={shotsFor(p)[0].alt} loading="lazy" decoding="async" width={shotsFor(p)[0].width} height={shotsFor(p)[0].height} />
        </figure>
      ) : (
        <Screen {...p.data.fragment} label={`Sample screen from ${shownName(p)}`} />
      )}
    </div>
  </article>
))}
