---
import { ui, type Locale } from '../i18n';
const { locale } = Astro.props as { locale: Locale };
const t = ui[locale].faq;
---
<section id="faq" data-field="#a6cdd3" data-ink="#16181d" class="faq-head">
  <h2 class="head reveal">{t.head}</h2>
</section>
<div class="faq">
  {t.qa.map(([q, a], i) => (
    <div class={`band ${i % 2 ? 'band--b' : 'band--a'}`} data-field={i % 2 ? '#dfd9cb' : '#f2eee6'} data-ink="#16181d">
      <h3 class="reveal">{q}</h3>
      <p class="reveal">{a}</p>
    </div>
  ))}
</div>
