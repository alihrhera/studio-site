---
import { getCollection } from 'astro:content';
import { layers, samples, shownName, sorted } from '../data/layers';
import Screen from './Screen.astro';

const projects = sorted(await getCollection('projects'));
---
<section id="layers" class="layers-head" data-field="#f2eee6" data-ink="#16181d">
  <h2 class="head reveal">Three layers. One product. One squad.</h2>
</section>
<div class="sheets">
  {layers.map((l, i) => (
    <article class="sheet" style={`--f:${l.color}; --i:${i}`} data-field={l.color} data-ink="#16181d">
      <h3 class="sheet-name">{l.label}</h3>
      <div class="sheet-body">
        <div>
          <p class="lead">{l.blurb}</p>
          <p class="small">Shipped in: {projects.filter((p) => p.data.layers.includes(l.id)).map(shownName).join(', ')}</p>
        </div>
        <Screen kind={l.kind} title={l.label} rows={samples[l.id]} label={`Sample ${l.label} screen`} />
      </div>
    </article>
  ))}
</div>
