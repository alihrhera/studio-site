---
import { layers } from '../data/layers';
import { ui, type Locale } from '../i18n';
const { locale } = Astro.props as { locale: Locale };
const t = ui[locale].team;
const color = (id: string) => layers.find((l) => l.id === id)!.color;
---
<section id="team" class="team" data-field="#dfd9cb" data-ink="#16181d">
  <h2 class="head reveal">{t.head}</h2>
  <ul class="people">
    {t.people.map((p) => (
      <li class="person reveal" style={`--f:${color(p.layer)}`}>
        <h3>{p.role}</h3>
        <p>{p.text}</p>
      </li>
    ))}
  </ul>
  <p class="statement reveal">{t.statement}</p>
</section>
