---
import { getCollection } from 'astro:content';
import { shownName, sorted } from '../data/layers';

const projects = sorted(await getCollection('projects'));
---
<section id="work" class="work-head" data-field="#f2eee6" data-ink="#16181d">
  <h2 class="head reveal">Six products, our part in each.</h2>
</section>
<div class="work-rows">
  {projects.map((p) => (
    <a class="work-row reveal" href={`/work/${p.id}/`} style={`--f:${p.data.color}`} data-field={p.data.color} data-ink="#16181d">
      <span class="work-row-name">{shownName(p)}</span>
      <span class="work-row-part">{p.data.role}</span>
      <span class="work-row-go">Case study</span>
    </a>
  ))}
</div>
<div class="work-foot" data-field="#f2eee6" data-ink="#16181d">
  <a class="btn reveal" href="/work/">See all work</a>
</div>
