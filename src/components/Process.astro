---
import { ui, type Locale } from '../i18n';
const { locale } = Astro.props as { locale: Locale };
const t = ui[locale].process;
const colors = ['var(--lemon)', 'var(--mint)', 'var(--cornflower)'];
---
<section id="process" class="process" data-field="#f2eee6" data-ink="#16181d">
  <h2 class="head reveal">{t.head}</h2>
  <div class="tiles">
    {t.stages.map((s, i) => (
      <div class={`stage stage--${i + 1}`}>
        <div class="tile reveal" style={`--f:${colors[i]}`}>
          <ul>{s.list.map((x) => <li>{x}</li>)}</ul>
        </div>
        <h3 class="stage-name reveal">{s.name}</h3>
        <p class="reveal">{s.text}</p>
      </div>
    ))}
  </div>
</section>
