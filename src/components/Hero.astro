---
import { getCollection } from 'astro:content';
import { layers, shownName, sorted, url } from '../data/layers';

const projects = sorted(await getCollection('projects'));
const forLayer = (id: string) => projects.filter((p) => p.data.layers.includes(id as never)).map(shownName);
---
<section class="hero" data-field="#f2eee6" data-ink="#16181d">
  <h1 class="hero-title reveal">We ship the whole product.</h1>
  <div class="hero-body">
    <div class="hero-copy">
      <p class="lead reveal">Four engineers across mobile, API and dashboard. The whole product from one squad.</p>
      <div class="hero-actions reveal">
        <a class="btn btn--accent" href="mailto:info@pollenbyte.com?subject=Audit%20request">Book a one-week audit</a>
        <a class="link" href={url('work/')}>See our work</a>
      </div>
      <ul class="picker reveal" aria-label="Pick a layer to see where we shipped it">
        {layers.map((l) => (
          <li style={`--c:${l.color}`}>
            <button type="button" data-layer={l.id} data-note={forLayer(l.id).join(', ')} aria-pressed="false">{l.label}</button>
          </li>
        ))}
      </ul>
      <p class="picker-note small reveal" id="picker-note" aria-live="polite">Pick a layer to see which products we shipped in it.</p>
    </div>
    <div class="stack" id="stack" data-layers={JSON.stringify(layers.map(({ id, label, color, kind }) => ({ id, label, color, kind })))}>
      <img class="stack-fallback" src={url('stack-fallback.svg')} width="900" height="760" alt="Three stacked layers: mobile, dashboard and API" />
    </div>
  </div>
</section>

<script>
  import type { StackHandle } from '../scripts/layer-stack';
  const host = document.getElementById('stack')!;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.picker button')];
  const note = document.getElementById('picker-note')!;
  let handle: StackHandle | null = null;
  let current: string | null = null;

  const set = (id: string | null) => {
    current = id;
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.layer === id)));
    host.dataset.selected = id ?? '';
    const b = buttons.find((x) => x.dataset.layer === id);
    note.innerHTML = '';
    if (b) { const s = document.createElement('strong'); s.textContent = `${b.textContent}: `; note.append(s, `shipped in ${b.dataset.note}.`); }
    else note.textContent = 'Pick a layer to see which products we shipped in it.';
    handle?.select(id);
  };
  buttons.forEach((b) => b.addEventListener('click', () => set(current === b.dataset.layer ? null : b.dataset.layer!)));

  // Load three.js only when the stack is near the screen.
  const io = new IntersectionObserver(async ([e]) => {
    if (!e.isIntersecting) return;
    io.disconnect();
    try {
      await document.fonts.load('500 30px "Hanken Grotesk Variable"');
      const { mountLayerStack } = await import('../scripts/layer-stack');
      handle = mountLayerStack(host, { layers: JSON.parse(host.dataset.layers!) });
      if (current) handle?.select(current);
    } catch { /* the static fallback stays */ }
  }, { rootMargin: '200px' });
  io.observe(host);
</script>
