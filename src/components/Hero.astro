---
import { getCollection } from 'astro:content';
import { layers, shownName, sorted, url } from '../data/layers';
import { ui, type Locale } from '../i18n';
import { bookAttrs, bookHref } from '../data/booking';

const { locale } = Astro.props as { locale: Locale };
const t = ui[locale];

const projects = sorted(await getCollection('projects'));
const forLayer = (id: string) => projects.filter((p) => p.data.layers.includes(id as never)).map((p) => shownName(p, locale));
---
<section class="hero" data-field="#f2eee6" data-ink="#16181d">
  <h1 class="hero-title reveal">{t.hero.title}</h1>
  <div class="hero-body">
    <div class="hero-copy">
      <p class="lead reveal">{t.hero.lead}</p>
      <div class="hero-actions reveal">
        <a class="btn btn--accent" href={bookHref(locale, `mailto:info@pollenbyte.com?subject=${encodeURIComponent(t.audit.subject)}`)} {...bookAttrs}>{t.hero.cta}</a>
        <a class="link" href={url('work/', locale)}>{t.hero.see}</a>
      </div>
      <ul class="picker reveal" aria-label={t.hero.pickerAria}>
        {layers.map((l) => (
          <li style={`--c:${l.color}`}>
            <button type="button" data-layer={l.id} data-note={forLayer(l.id).join(t.sep)} aria-pressed="false">{t.layers[l.id].label}</button>
          </li>
        ))}
      </ul>
      <p class="picker-note small reveal" id="picker-note" aria-live="polite" data-default={t.hero.pickerNote} data-pre={t.hero.shippedPre}>{t.hero.pickerNote}</p>
    </div>
    <div class="stack" id="stack" data-layers={JSON.stringify(layers.map(({ id, label, color, kind }) => ({ id, label, color, kind })))}>
      <img class="stack-fallback" src={url('stack-fallback.svg')} width="724" height="570" alt={t.hero.stackAlt} fetchpriority="high" />
    </div>
  </div>
</section>

<script>
  import type { StackHandle } from '../scripts/layer-stack';
  const host = document.getElementById('stack')!;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.picker button')];
  const note = document.getElementById('picker-note')!;
  const { default: fallback, pre } = note.dataset as { default: string; pre: string };
  let handle: StackHandle | null = null;
  let current: string | null = null;

  const set = (id: string | null) => {
    current = id;
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.layer === id)));
    host.dataset.selected = id ?? '';
    const b = buttons.find((x) => x.dataset.layer === id);
    note.innerHTML = '';
    if (b) { const s = document.createElement('strong'); s.textContent = `${b.textContent}: `; note.append(s, `${pre}${b.dataset.note}.`); }
    else note.textContent = fallback;
    handle?.select(id);
  };
  buttons.forEach((b) => b.addEventListener('click', () => set(current === b.dataset.layer ? null : b.dataset.layer!)));

  // Load three.js only when the stack is near the screen.
  const io = new IntersectionObserver(async ([e]) => {
    if (!e.isIntersecting) return;
    io.disconnect();
    try {
      await document.fonts.load('500 30px "Hanken Grotesk Variable"');
      const { mountLayerStack } = await import('../scripts/layer-stack');
      handle = mountLayerStack(host, { layers: JSON.parse(host.dataset.layers!) });
      if (current) handle?.select(current);
    } catch { /* the static fallback stays */ }
  }, { rootMargin: '200px' });
  // Arm after load so the three.js bundle stays off the critical path (LCP is the static image).
  const arm = () => setTimeout(() => io.observe(host), 1200);
  if (document.readyState === 'complete') arm(); else addEventListener('load', arm, { once: true });
</script>

