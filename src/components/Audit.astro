---
import { ui, type Locale } from '../i18n';
const { locale } = Astro.props as { locale: Locale };
const t = ui[locale].audit;
---
<section id="audit" class="audit" data-field="#16181d" data-ink="#f2eee6">
  <h2 class="head reveal">{t.head}</h2>
  <div class="audit-foot">
    <p class="lead reveal">{t.lead}</p>
    <a class="btn btn--ink reveal" href={`mailto:info@pollenbyte.com?subject=${encodeURIComponent(t.subject)}`}>{t.cta}</a>
  </div>
</section>
