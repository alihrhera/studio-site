---
import '@fontsource-variable/hanken-grotesk';
import '@fontsource-variable/cairo';
import '../styles/tokens.css';
import '../styles/global.css';
import { url } from '../data/layers';
import { bookAttrs, bookHref } from '../data/booking';
import { dirOf, otherLocale, ui, type Locale } from '../i18n';
import Wordmark from '../components/Wordmark.astro';

interface Props { title: string; description: string; locale: Locale }
const { title, description, locale } = Astro.props;
const t = ui[locale];
const other = otherLocale(locale);
// The same page in the other language: drop the base and any /ar/ prefix, then re-add it.
const rest = Astro.url.pathname.slice(import.meta.env.BASE_URL.replace(/\/$/, '').length).replace(/^\/(ar(\/|$))?/, '');
const abs = (l: Locale) => (Astro.site ? new URL(url(rest, l), Astro.site).href : null);
---

<!doctype html>
<html lang={locale} dir={dirOf(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {abs('en') && <>
      <link rel="canonical" href={abs(locale)} />
      <link rel="alternate" hreflang="en" href={abs('en')} /><link rel="alternate" hreflang="ar" href={abs('ar')} /><link rel="alternate" hreflang="x-default" href={abs('en')} />
      <meta property="og:type" content="website" />
      <meta property="og:site_name" content="PollenByte" />
      <meta property="og:title" content={title} />
      <meta property="og:description" content={description} />
      <meta property="og:url" content={abs(locale)} />
      <meta property="og:locale" content={locale === 'ar' ? 'ar_AR' : 'en_US'} />
      <meta property="og:image" content={new URL(url('og.png'), Astro.site).href} />
      <meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content={t.hero.stackAlt} />
      <meta name="twitter:card" content="summary_large_image" />
      <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url: abs(locale), inLanguage: locale, isPartOf: { '@type': 'WebSite', name: 'PollenByte', url: new URL(url('', 'en'), Astro.site).href } })} />
    </>}
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
  </head>
  <body>
    <header class="nav" id="nav">
      <a class="nav-mark" href={url('', locale)} aria-label={t.nav.home}><Wordmark /></a>
      <nav class="nav-links" aria-label={t.nav.main}>
        <a href={url('work/', locale)} aria-current={Astro.url.pathname.startsWith(url('work', locale)) ? 'page' : undefined}>{t.nav.work}</a>
        <a href={url('#layers', locale)}>{t.nav.cover}</a>
        <a href={url('#pricing', locale)}>{t.nav.pricing}</a>
        <a href={url('#team', locale)}>{t.nav.team}</a>
      </nav>
      <a class="nav-lang" href={url(rest, other)} lang={other} hreflang={other}>{t.switchTo}</a>
      <a class="btn" href={bookHref(locale, url('#audit', locale))} {...bookAttrs}>{t.nav.cta}</a>
    </header>
    <main>
      <slot />
    </main>
    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>
